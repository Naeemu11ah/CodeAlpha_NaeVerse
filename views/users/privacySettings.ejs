<%- layout('/layout/boilerplate') %>

<div class="card mt-4">
  <div class="card-body">
    <h2>Privacy Settings</h2>
    <form
      method="post"
      action="/user/<%= user._id %>/privacy?__method=PATCH"
      class="mt-3 border border-secondary p-3 rounded"
    >
      <h5 class="mb-3">Profile Visibility</h5>
      <div class="form-check ms-3">
        <input class="form-check-input" type="radio" name="privacy"
        id="privacyPublic" value="public" <%= user.privacy === 'public' ?
        'checked' : '' %> />
        <label class="form-check-label" for="privacyPublic"
          >Public Account — anyone can follow you and can view your posts</label
        >
      </div>
      <div class="form-check mt-2 ms-3">
        <input class="form-check-input" type="radio" name="privacy"
        id="privacyPrivate" value="private" <%= user.privacy === 'private' ?
        'checked' : '' %> />
        <label class="form-check-label" for="privacyPrivate"
          >Private Account — follow requests must be approved and your posts are
          only visible to your friends</label
        >
      </div>
      <div class="mt-3">
        <button class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>
