<%- layout("/layout/boilerplate") %>
<body>
  <div class="outermostDiv">
    <div style="width: 300px" class="border p-2 rounded-3 border-secondary">
      <h4 class="text-center">
        Select new profile<span style="color: red"> picture</span>
      </h4>
      <form
        method="post"
        action="/user/profile/<%= user._id %>/editProfilePic?__method=PATCH"
        class="needs-validation"
        novalidate
        enctype="multipart/form-data"
      >
        <div class="d-flex justify-content-center my-3">
          <input
            type="file"
            id="fileInput"
            name="profilePic"
            class="d-none"
            accept="image/*"
            required
          />
          <label
            for="fileInput"
            id="fileLabel"
            class="border borderd-2 border-secondary d-flex justify-content-center align-items-center position-relative overflow-hidden"
            tabindex="0"
            style="
              width: 150px;
              height: 150px;
              cursor: pointer;
              border-radius: 50%;
            "
          >
            <span id="plusIcon" class="fs-1 text-secondary">+</span>
            <img
              id="previewImage"
              class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover d-none"
            />
          </label>
        </div>
        <button type="submit" class="btn btn-success w-100 mt-2">Update</button>
      </form>
      <form
        method="post"
        action="/user/profile/<%= user._id %>/editProfilePic?__method=DELETE"
        class="d-inline"
      >
        <button type="submit" class="btn btn-danger w-100 mt-2">Remove profile picture</button>
      </form>
    </div>
  </div>
  <style>
    .is-invalid-border {
      border-color: #dc3545 !important;
      box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
    }
  </style>
  <script src="/js/viewLabelPic.js"></script>
</body>
