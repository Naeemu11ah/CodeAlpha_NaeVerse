<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- basic SEO meta tags -->
    <meta
      name="description"
      content="<%= metaDescription || 'Browse UOS past exam papers by subject and teacher' %>"
    />
    <meta
      name="keywords"
      content="UOS past papers, University of Swat, exam papers,exam past paper, subjects, teachers"
    />
    <meta name="robots" content="index, follow" />
    <!-- Open Graph / Social sharing -->
    <meta property="og:title" content="<%= title || 'UOS Past Papers' %>" />
    <meta
      property="og:description"
      content="<%= metaDescription || 'Browse UOS past exam papers by subject and teacher' %>"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="<%= request.originalUrl %>" />
    <meta
      property="og:image"
      content="https://res.cloudinary.com/durkwcjdo/image/upload/v1772731033/uos_web_logo_mdsate.png"
    />
    <title><%= title || 'NaeVerse' %></title>
    <link rel="icon" href="/assets/favicon.ico" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
      integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="/CSS/style.css" />
    <!-- inline theme initialization to avoid flash-of-unstyled-theme -->
    <script>
      (function () {
        try {
          // default mood is dark; only add dark-mode class when stored preference
          const theme = localStorage.getItem("theme") || "dark";
          const el = document.body || document.documentElement;
          if (theme === "dark") {
            el.classList.add("dark-mode");
          } else {
            el.classList.remove("dark-mode");
          }
        } catch (e) {
          // localStorage not available; ignore
        }
      })();
    </script>
  </head>
  <body>
    <!-- global loader overlay -->
    <div id="loader-overlay" class="d-none">
      <div
        class="d-flex flex-column justify-content-center align-items-center h-100"
      >
        <div
          class="spinner-border text-primary"
          role="status"
          style="width: 3rem; height: 3rem"
        ></div>
        <p class="mt-3 text-white">Processing...</p>
      </div>
    </div>
    <div class="d-flex vh-100">
      <div class="sidePanel h-100"><%- include("../includes/sidePanel") %></div>
      <div class="mainScreen flex-grow-1 h-100">
        <div class="container h-100 paddingContronlMobileScreen">
          <%- include("../includes/flash") %> <%- body %>
          <%- include("../includes/bottomNav")  %>
        </div>
      </div>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
    <script src="/js/script.js"></script>
    <script src="/js/showPassswordCheckbox.js"></script>
    <script src="/js/modalAuth.js"></script>
    <!-- Modal container for auth (login/signup) -->
    <div id="auth-modal" class="auth-modal d-none" aria-hidden="true"></div>
  </body>
</html>
