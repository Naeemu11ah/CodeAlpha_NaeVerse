<%
function isActiveExact(path) {
  if (!currentPath) return "";
  return currentPath === path ? "active" : "";
}

function isActiveStartsWith(prefix) {
  if (!currentPath) return "";
  return currentPath === prefix || currentPath.startsWith(prefix + "/") ? "active" : "";
}

function isActiveRegex(re) {
  if (!currentPath) return "";
  return re.test(currentPath) ? "active" : "";
}
%>

<nav class="navbar navbar-expand-md bg-body-tertiary sticky-top p-0">
  <div class="d-flex flex-column gap-2 p-3 bg-white" style="width: 220px">
    <a class="navbar-brand d-flex align-items-center" href="/post"
      ><img
        src="/assets/favicon.ico"
        alt="logo"
        style="width: 40px; height: 40px"
      /><span class="fw-bold fs-4">NaeVerse</span></a
    >

    <%- include("../includes/searchBar") %>

    <a class="nav-link d-inline <%= isActiveExact('/post') %>" href="/post"
      ><div class="d-flex gap-3 align-content-center">
        <i class="fa-solid fa-house" style="font-size: 19px"></i
        ><span class="fw-semibold">For You</span>
      </div></a
    >
    <a class="nav-link d-inline <%= isActiveRegex(/^\/user\/[^\/]+\/following$/) %>"
      href="<%= currentUser ? ('/user/' + currentUser._id + '/following') : 'javascript:void(0)' %>"
      <%= !currentUser ? 'data-login-required="1" onclick="alert(\'Please login first to continue\'); return false;"' : '' %>
      ><div class="d-flex gap-3 align-content-center">
          <i class="fa-solid fa-user-check" style="font-size: 19px"></i
          ><span class="fw-semibold">Following</span>
        </div></a
    >
    <a class="nav-link d-inline <%= isActiveExact('/friends') %>" href="<%= currentUser ? ('/user/' + currentUser._id + '/friends') : 'javascript:void(0)' %>" <%= !currentUser ? 'data-login-required="1" onclick="alert(\'Please login first to continue\'); return false;"' : '' %>>
      <div class="d-flex gap-3 align-content-center">
        <i class="fa-solid fa-user-friends" style="font-size: 19px"></i
        ><span class="fw-semibold">Friends</span>
      </div></a
    >
    <a id="activity-link" class="nav-link d-inline <%= isActiveExact('/activity') %>" href="<%= currentUser ? ('/user/' + currentUser._id + '/activity') : 'javascript:void(0)' %>" <%= !currentUser ? 'data-login-required="1" onclick="alert(\'Please login first to continue\'); return false;"' : '' %>>
      <div class="d-flex gap-3 align-content-center">
        <i class="fa-solid fa-message" style="font-size: 19px"></i>
        <span class="fw-semibold">Activity</span>
        <span id="notif-badge" class="badge bg-danger notif-count d-none d-flex align-items-center justify-content-center rounded-circle" style="position: relative; top: -10px; right: 15px;">0</span>
      </div></a>
    

    <a class="nav-link d-inline <%= isActiveRegex(/^\/user\/profile\/[^\/]+$/) %>"
      href="<%= currentUser ? ('/user/profile/' + currentUser._id) : 'javascript:void(0)' %>" <%= !currentUser ? 'data-login-required="1" onclick="alert(\'Please login first to continue\'); return false;"' : '' %>
    >
      <div class="d-flex gap-3 align-content-center">
        <% let profilePicSrc = '/assets/userProfilePic.png'; if (currentUser &&
        currentUser.profilePic) { const pp = currentUser.profilePic; const url =
        (typeof pp === 'string') ? pp : (pp && pp.url ? pp.url : null); if (url)
        { profilePicSrc = /^https?:\/\//i.test(url) || url.startsWith('/') ? url
        : '/' + url; } } %>
        <img
          src="<%= profilePicSrc %>"
          alt="userProfilePicture"
          class="rounded-circle"
          style="width: 25px; height: 25px; object-fit: cover"
        />
        <span class="fw-semibold">Profile</span>
      </div>
    </a>
    <a class="nav-link d-inline no-active-color" href="<%= currentUser ? '/post/new' : 'javascript:void(0)' %>" <%= !currentUser ? 'data-login-required="1" onclick="alert(\'Please login first to continue\'); return false;"' : '' %>>
      <div class="d-flex gap-3 align-content-center">
        <i class="fa-regular fa-square-plus" style="font-size: 19px"></i
        ><span class="fw-semibold">Upload</span>
      </div></a
    >
    <hr />
    <button
      id="theme-toggle"
      class="btn-link nav-link d-flex gap-3"
      title="Toggle theme"
    >
      <i id="theme-icon" class="fa-solid"></i>
      <span id="theme-text">Theme</span>
    </button>

    <a class="nav-link d-inline <%= isActiveExact('/privacySettings') %>" href="<%= currentUser ? '/privacySettings' : 'javascript:void(0)' %>" <%= !currentUser ? 'data-login-required="1" onclick="alert(\'Please login first to continue\'); return false;"' : '' %>>
      <div class="d-flex gap-3 align-content-center">
        <i class="fa-solid fa-unlock-keyhole" style="font-size: 19px"></i
        ><span class="fw-semibold">Privacy</span>
      </div></a
    >

<script>
  // Ensure login-required links always show an alert even if other handlers intercept clicks.
  (function () {
    function handler(e) {
      var a = e.target && e.target.closest && e.target.closest('a[data-login-required]');
      if (!a) return;
      e.preventDefault();
      try { e.stopImmediatePropagation(); } catch (err) {}
      alert('Please login first to continue');
      return false;
    }
    // capture-phase so it runs before other bubble handlers
    document.addEventListener('click', handler, true);
  })()
</script>

    <% if (currentUser) { %>
    <a class="nav-link d-inline" href="/logout"
      ><div class="d-flex gap-3 align-content-center">
        <i class="fa-solid fa-up-right-from-square" style="font-size: 19px"></i
        ><span class="fw-semibold">Log out</span>
      </div></a
    >
    <form action="/user/<%= currentUser._id %>/delete?__method=DELETE"
      class="nav-link d-inline"
      method="post"
      onsubmit="return confirm('Are you sure you want to delete your account?')"
    >
      <button
        type="submit"
        style="border: none !important ; color: rgb(161, 27, 27);"
        class="d-flex p-0 bg-transparent gap-3 align-content-center"
      >
        <i class="fa-solid fa-trash-can" style="font-size: 19px"></i
        ><span class="fw-semibold">Delete account</span>
      </button>
    </form>

    <%}%> <% if (!currentUser) { %>
    <a class="nav-link d-inline <%= isActiveExact('/login') %>" href="/login"
      ><div class="d-flex gap-3 align-content-center">
        <i class="fa-solid fa-right-to-bracket" style="font-size: 19px"></i
        ><span class="fw-semibold">Log in</span>
      </div></a
    >
    <a class="nav-link d-inline <%= isActiveExact('/signup') %>" href="/signup"
      ><div class="d-flex gap-3 align-content-center">
        <i class="fa-solid fa-user-plus" style="font-size: 19px"></i
        ><span class="fw-semibold">Sign up</span>
      </div></a
    >
    <% } %>
    <hr />
    <a class="nav-link d-inline" href="/about">
      <span class="text-secondary" style="font-size: 1rem">About us</span>
    </a>
    <a class="nav-link d-inline" href="/terms">
      <span class="text-secondary" style="font-size: 1rem">Terms & conditions</span>
    </a>
    <a class="nav-link d-inline" href="/privacy">
      <span class="text-secondary" style="font-size: 1rem">Policy & privacy</span>
    </a>
    <span class="text-secondary" style="font-size: 1rem">&copy; 2026 NaeVerse</span>
  </div>
</nav>
